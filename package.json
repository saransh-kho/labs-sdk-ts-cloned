{
  "name": "@wbd/labs-sdk-ts",
  "description": "TypeScript library for running experiments on JS clients.",
  "version": "2.6.1",
  "author": "Warner Bros Discovery",
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/esm/index.mjs",
  "browser": "dist/labs-sdk-prod.js",
  "browser-dev": "dist/labs-sdk-dev.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "import": "./dist/labs-sdk-prod.js",
        "require": "./dist/index.js"
      },
      "import": "./dist/esm/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "bin": {
    "labs-cli": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbd-streaming/labs-sdk-ts.git"
  },
  "bugs": {
    "url": "https://github.com/wbd-streaming/labs-sdk-ts/issues"
  },
  "homepage": "https://github.com/wbd-streaming/labs-sdk-ts#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "run-s build-ts build-esm build-dev build-prod build-cli stamp-version",
    "build-ts": "tsc -p tsconfig.cjs.json",
    "build-esm": "rollup --config rollup.esm.config.mjs",
    "build-dev": "rollup --config",
    "build-prod": "rollup --config --configProd",
    "build-cli": "rollup --config rollup.cli.config.mjs && chmod +x dist/cli.mjs",
    "stamp-version": "node scripts/stamp-version.mjs",
    "test": "jest",
    "coverage": "npm run test -- --coverage",
    "prepare": "husky",
    "dev": "ts-node-dev --exit-child src/index.ts",
    "start": "ts-node src/index.ts",
    "cli": "npm run build-cli --silent && node dist/cli.mjs"
  },
  "lint-staged": {
    "*.(ts|json|yml|yaml|md)": "prettier --write",
    "*.ts": "eslint --fix"
  },
  "dependencies": {
    "compare-versions": "6.1.1",
    "json-logic-engine": "^5.0.2",
    "long": "5.2.3",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "5.1.1",
    "@rollup/plugin-inject": "5.0.5",
    "@rollup/plugin-node-resolve": "15.3.0",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.1.1",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.12",
    "@types/node": "25.9.3",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.12.0",
    "@typescript-eslint/parser": "8.12.0",
    "buffer-es6": "4.9.3",
    "eslint": "9.0.0",
    "eslint-config-prettier": "9.1.0",
    "husky": "9.1.6",
    "jest": "29.7.0",
    "lint-staged": "15.5.2",
    "lodash": "4.18.1",
    "npm-run-all": "4.1.5",
    "prettier": "3.3.3",
    "rollup": "4.62.0",
    "rollup-plugin-node-externals": "7.1.3",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "tslib": "2.8.0",
    "typescript": "5.6.3"
  }
}
